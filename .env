# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380

# Encryption Configuration
# JWT_SECRET should be a HS256-compatible key (at least 256 bits/32 bytes, hex or base64 encoded)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# AES_SECRET_KEY must be exactly 16, 24, or 32 characters long for AES-128/192/256
AES_SECRET_KEY=SuperSecretVaultKeyEncryptAtRest12

# Third Party Integrations (Optional / Mock defaults)
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=mock_auth_token_value
